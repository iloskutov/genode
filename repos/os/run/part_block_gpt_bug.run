create_boot_directory

#
# Build GPT image with 31 table entries and 4KB sector size as on Pixel phone
#
set dd     [installed_command dd]
catch { exec $dd if=/dev/zero of=bin/gpt.img bs=4K count=16 }
set echo   [installed_command echo]
set cmd "label: gpt
first-lba: 6
table-length: 31
gpt.img1 : start=6, size=4"
catch { exec $echo $cmd > bin/part.txt}
set sfdisk [installed_command sfdisk]
catch { exec $sfdisk --sector-size 4096 bin/gpt.img < bin/part.txt }

build {
	core init timer lib/ld
	server/vfs_block
	server/part_block
  server/report_rom
	lib/vfs lib/vfs_import
}

install_config {
config | verbose: yes
+ parent-provides
  + service ROM
  + service IRQ
  + service IO_MEM
  + service IO_PORT
  + service PD
  + service RM
  + service CPU
  + service LOG

+ default-route
  + any-service
    + parent
    + any-child

+ default | caps: 100 | ram: 1M

+ start timer
  + provides | + service Timer

+ start vfs_block | ram: 32M
  + provides | + service Block
  + config
    + vfs
      + ram
      + import | + rom gpt.img
    + default-policy | file: gpt.img | block_size: 4096

+ start part_block | ram: 10M
  + provides | + service Block
  + route
  | + any-service
  |   + child vfs_block
  |   + parent
  |   + any-child
  + config
    + report | partitions: yes 

+ start report_rom | ram: 5M
  + provides
    + service Report
    + service ROM
  + config | verbose: yes
-
}

build_boot_image [list {*}[build_artifacts] gpt.img]

run_genode_until {\[init\] child \"part_block\" announces service \"Block\".+\n} 30

file delete bin/gpt.img

