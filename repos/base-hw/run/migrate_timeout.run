#
# Move a thread blocked on its kernel timeout to another (idle) CPU,
# the timeout must end in time (src/test/migrate_timeout)
#

assert {[have_spec hw]}
assert {[have_include power_on/qemu]}

build { core init lib/ld test/migrate_timeout }

create_boot_directory

install_config {
config
+ parent-provides
  + service LOG
  + service PD
  + service CPU
  + service ROM

+ default-route
  + any-service
    + parent

+ start test-migrate_timeout | caps: 100 | ram: 2M
-
}

build_boot_image [build_artifacts]

append qemu_args " -nographic -smp 4"

run_genode_until {.*--- test (succeeded|failed) ---.*\n} 60

grep_output {^\[init -> test-migrate_timeout\] (move|Error|--- test)}

compare_output_to {
[init -> test-migrate_timeout] move 1->2: timeout in time
[init -> test-migrate_timeout] move 2->3: timeout in time
[init -> test-migrate_timeout] move 3->1: timeout in time
[init -> test-migrate_timeout] move 1->0: timeout in time
[init -> test-migrate_timeout] move 0->2: timeout in time
[init -> test-migrate_timeout] move 1->2: timeout in time
[init -> test-migrate_timeout] move 2->3: timeout in time
[init -> test-migrate_timeout] move 3->1: timeout in time
[init -> test-migrate_timeout] move 1->0: timeout in time
[init -> test-migrate_timeout] move 0->2: timeout in time
[init -> test-migrate_timeout] move 1->2: timeout in time
[init -> test-migrate_timeout] move 2->3: timeout in time
[init -> test-migrate_timeout] move 3->1: timeout in time
[init -> test-migrate_timeout] move 1->0: timeout in time
[init -> test-migrate_timeout] move 0->2: timeout in time
[init -> test-migrate_timeout] --- test succeeded ---
}
